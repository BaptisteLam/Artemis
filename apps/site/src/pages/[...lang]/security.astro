---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, href } = i18n(Astro.url);
---
<Base title={t('security.title')} description={t('security.description')}>
  <PageHead eyebrow={t('security.eyebrow')} title={t('security.headline')} lead={t('security.lead')} />
  <div class="ar-container section">
    <article class="prose">
      <h2>{t('security.funds.title')}</h2>
      <p>{t('security.funds.body')}</p>
      <h2>{t('security.defense.title')}</h2>
      <ul class="check">
        <li>{t('security.defense.i1')}</li>
        <li>{t('security.defense.i2')}</li>
        <li>{t('security.defense.i3')}</li>
        <li>{t('security.defense.i4')}</li>
        <li>{t('security.defense.i5')}</li>
        <li>{t('security.defense.i6')}</li>
      </ul>
      <h2>{t('security.cardNumbers.title')}</h2>
      <p>{t('security.cardNumbers.body')}</p>
      <h2>{t('security.mandates.title')}</h2>
      <p>{t('security.mandates.body')}</p>
      <h2>{t('security.aiAct.title')}</h2>
      <p>{t('security.aiAct.body')}</p>
      <h2>{t('security.data.title')}</h2>
      <p><Fragment set:html={t('security.data.body', { href: href('/privacy') })} /></p>
      <h2>{t('security.report.title')}</h2>
      <p><Fragment set:html={t('security.report.body', { href: href('/legal-notice') })} /></p>
    </article>
  </div>
</Base>
