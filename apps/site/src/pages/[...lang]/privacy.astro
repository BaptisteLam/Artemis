---
import LegalLayout from '../../components/LegalLayout.astro';
import { LEGAL } from '../../legal';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<LegalLayout title={t('legalPages.privacy.title')}>
  <h2>{t('legalPages.privacy.controllerTitle')}</h2>
  <p>{t('legalPages.privacy.controller', { editor: LEGAL.editor, email: LEGAL.email })}</p>
  <h2>{t('legalPages.privacy.dataTitle')}</h2>
  <ul>
    <li>{t('legalPages.privacy.dataAccount')}</li>
    <li>{t('legalPages.privacy.dataActivity')}</li>
    <li>{t('legalPages.privacy.dataBanks')}</li>
    <li>{t('legalPages.privacy.dataBilling')}</li>
    <li>{t('legalPages.privacy.dataWaitlist')}</li>
  </ul>
  <p>{t('legalPages.privacy.cardNumbers')}</p>
  <h2>{t('legalPages.privacy.purposesTitle')}</h2>
  <p>{t('legalPages.privacy.purposes')}</p>
  <h2>{t('legalPages.privacy.processorsTitle')}</h2>
  <p>{t('legalPages.privacy.processors')}</p>
  <h2>{t('legalPages.privacy.retentionTitle')}</h2>
  <p>{t('legalPages.privacy.retention')}</p>
  <h2>{t('legalPages.privacy.rightsTitle')}</h2>
  <p>{t('legalPages.privacy.rights', { email: LEGAL.email })}</p>
  <h2>{t('legalPages.privacy.cookiesTitle')}</h2>
  <p>{t('legalPages.privacy.cookies')}</p>
</LegalLayout>
