---
import LegalLayout from '../../components/LegalLayout.astro';
import { LEGAL } from '../../legal';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, href, money } = i18n(Astro.url);
const eur = (n: number) => money(n * 100, { whole: true });
---
<LegalLayout title={t('legalPages.terms.title')}>
  <h2>{t('legalPages.terms.purposeTitle')}</h2>
  <p>{t('legalPages.terms.purpose', { editor: LEGAL.editor, status: t('legal.status'), siret: LEGAL.siret })}</p>
  <h2>{t('legalPages.terms.serviceTitle')}</h2>
  <p>{t('legalPages.terms.service')}</p>
  <h2>{t('legalPages.terms.accountTitle')}</h2>
  <p>{t('legalPages.terms.account')}</p>
  <h2>{t('legalPages.terms.pricesTitle')}</h2>
  <p>{t('legalPages.terms.prices', { builder: eur(29), team: eur(99), agency: eur(249), perClient: eur(15), business: eur(690), overage: money(25), vat: t('legal.vat') })}</p>
  <h2>{t('legalPages.terms.quotasTitle')}</h2>
  <p>{t('legalPages.terms.quotas')}</p>
  <h2>{t('legalPages.terms.availabilityTitle')}</h2>
  <p>{t('legalPages.terms.availability')}</p>
  <h2>{t('legalPages.terms.liabilityTitle')}</h2>
  <p>{t('legalPages.terms.liability')}</p>
  <h2>{t('legalPages.terms.dataTitle')}</h2>
  <p><Fragment set:html={t('legalPages.terms.data', { href: href('/privacy') })} /></p>
  <h2>{t('legalPages.terms.lawTitle')}</h2>
  <p>{t('legalPages.terms.law')}</p>
</LegalLayout>
