---
import LegalLayout from '../../../components/LegalLayout.astro';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<LegalLayout title={t('agentPolicy.title')}>
  <p>{t('agentPolicy.intro')}</p>
  <h2>{t('agentPolicy.scope.title')}</h2>
  <p>{t('agentPolicy.scope.body')}</p>
  <h2>{t('agentPolicy.register.title')}</h2>
  <p>{t('agentPolicy.register.body')}</p>
  <h2>{t('agentPolicy.rules.title')}</h2>
  <ul>
    <li>{t('agentPolicy.rules.i1')}</li>
    <li>{t('agentPolicy.rules.i2')}</li>
    <li>{t('agentPolicy.rules.i3')}</li>
    <li>{t('agentPolicy.rules.i4')}</li>
  </ul>
  <h2>{t('agentPolicy.oversight.title')}</h2>
  <p>{t('agentPolicy.oversight.body')}</p>
  <h2>{t('agentPolicy.records.title')}</h2>
  <p>{t('agentPolicy.records.body')}</p>
  <h2>{t('agentPolicy.incidents.title')}</h2>
  <p>{t('agentPolicy.incidents.body')}</p>
  <h2>{t('agentPolicy.retention.title')}</h2>
  <p>{t('agentPolicy.retention.body')}</p>
  <p><em>{t('agentPolicy.note', { plan: t('plans.business') })}</em></p>
</LegalLayout>
