---
import DocsLayout from '../../../components/DocsLayout.astro';
import { API_URL, MCP_URL } from '../../../config';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<DocsLayout title={t('docs.n8n.title')} lead={t('docs.n8n.lead')}>
  <h2>{t('docs.n8n.agentTitle')}</h2>
  <p><Fragment set:html={t('docs.n8n.agentBody', { url: MCP_URL })} /></p>
  <h2>{t('docs.n8n.workflowTitle')}</h2>
  <p><Fragment set:html={t('docs.n8n.workflowBody')} /></p>
  <ol>
    <li><code>POST {API_URL}/v1/card-requests</code> {t('docs.n8n.step1With')} <code>{`{ "amount": 4900, "merchant": "Notion", "purpose": "team subscription" }`}</code></li>
    <li><Fragment set:html={t('docs.n8n.step2')} /></li>
    <li><Fragment set:html={t('docs.n8n.step3')} /></li>
  </ol>
</DocsLayout>
