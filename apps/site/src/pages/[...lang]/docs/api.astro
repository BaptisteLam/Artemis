---
import DocsLayout from '../../../components/DocsLayout.astro';
import { API_URL } from '../../../config';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
const endpoints = [
  ['POST', '/v1/card-requests', 'create'],
  ['GET', '/v1/card-requests/:id', 'status'],
  ['POST', '/v1/card-requests/:id/reveal', 'reveal'],
  ['POST', '/v1/card-requests/:id/cancel', 'cancel'],
  ['POST', '/v1/card-requests/:id/receipts', 'receipts'],
  ['GET', '/v1/budgets', 'budgets'],
  ['GET', '/v1/spend-summary?period=month', 'spendSummary'],
] as const;
---
<DocsLayout title={t('docs.api.title')} lead={t('docs.api.lead')}>
  <h2>{t('docs.api.authTitle')}</h2>
  <pre><code>{`Authorization: Bearer art_live_…`}</code></pre>
  <p><Fragment set:html={t('docs.api.base', { url: API_URL })} /></p>
  <h2>{t('docs.api.endpointsTitle')}</h2>
  <table>
    <thead><tr><th>{t('docs.api.method')}</th><th>{t('docs.api.path')}</th><th>{t('docs.api.role')}</th></tr></thead>
    <tbody>
      {endpoints.map(([method, path, key]) => (
        <tr><td>{method}</td><td><code>{path}</code></td><td>{t(`docs.api.${key}`)}</td></tr>
      ))}
    </tbody>
  </table>
  <h2>{t('docs.api.exampleTitle')}</h2>
  <pre><code>{`curl -X POST ${API_URL}/v1/card-requests \\
  -H "Authorization: Bearer art_test_…" \\
  -H "Content-Type: application/json" \\
  -d '{"amount":4900,"currency":"EUR","merchant":"Notion","purpose":"team subscription"}'

{"request_id":"…","status":"pending_approval"}`}</code></pre>
  <h2>{t('docs.api.errorsTitle')}</h2>
  <pre><code>{`{ "error": { "code": "over_monthly_budget", "message": "…" } }`}</code></pre>
  <p><Fragment set:html={t('docs.api.errorsBody')} /></p>
</DocsLayout>
