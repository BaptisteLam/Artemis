---
import DocsLayout from '../../../components/DocsLayout.astro';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<DocsLayout title={t('docs.cli.title')} lead={t('docs.cli.lead')}>
  <h2>{t('docs.cli.commandTitle')}</h2>
  <pre><code>npx artemis-agents init</code></pre>
  <p><Fragment set:html={t('docs.cli.commandBody')} /></p>
  <pre><code>{`npx artemis-agents status
npx artemis-agents request --amount 49.00 --merchant Notion --purpose "team subscription"`}</code></pre>
  <h2>{t('docs.cli.skillTitle')}</h2>
  <p><Fragment set:html={t('docs.cli.skillBody')} /></p>
  <h2>{t('docs.cli.n8nTitle')}</h2>
  <p><Fragment set:html={t('docs.cli.n8nBody')} /></p>
</DocsLayout>
