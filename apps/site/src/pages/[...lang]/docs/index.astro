---
import DocsLayout from '../../../components/DocsLayout.astro';
import { APP_URL, MCP_URL } from '../../../config';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, href, locale } = i18n(Astro.url);
const tools = [
  ['request_card', 'requestCard'],
  ['get_request_status', 'getRequestStatus'],
  ['get_card_for_checkout', 'getCardForCheckout'],
  ['list_budgets', 'listBudgets'],
  ['get_spend_summary', 'getSpendSummary'],
  ['attach_receipt', 'attachReceipt'],
  ['cancel_card', 'cancelCard'],
] as const;
---
<DocsLayout title={t('docs.index.title')} lead={t('docs.index.lead')}>
  <h2>{t('docs.index.step1.title')}</h2>
  <p><Fragment set:html={t('docs.index.step1.body', { href: `${APP_URL}/signup?lang=${locale}` })} /></p>
  <h2>{t('docs.index.step2.title')}</h2>
  <p><Fragment set:html={t('docs.index.step2.body')} /></p>
  <h2>{t('docs.index.step3.title')}</h2>
  <p><Fragment set:html={t('docs.index.step3.fastest', { cli: href('/docs/cli') })} /></p>
  <p><Fragment set:html={t('docs.index.step3.server', { url: MCP_URL, claude: href('/docs/mcp-claude'), chatgpt: href('/docs/mcp-chatgpt'), n8n: href('/docs/n8n'), api: href('/docs/api') })} /></p>
  <h2>{t('docs.index.step4.title')}</h2>
  <table>
    <thead><tr><th>{t('docs.index.step4.tool')}</th><th>{t('docs.index.step4.role')}</th></tr></thead>
    <tbody>
      {tools.map(([name, key]) => (
        <tr><td><code>{name}</code></td><td><Fragment set:html={t(`docs.index.step4.${key}`)} /></td></tr>
      ))}
    </tbody>
  </table>
  <h2>{t('docs.index.step5.title')}</h2>
  <p><Fragment set:html={t('docs.index.step5.body')} /></p>
</DocsLayout>
