---
import DocsLayout from '../../../components/DocsLayout.astro';
import { MCP_URL } from '../../../config';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, money } = i18n(Astro.url);
---
<DocsLayout title={t('docs.mcpClaude.title')} lead={t('docs.mcpClaude.lead')}>
  <h2>Claude Code</h2>
  <pre><code>{`claude mcp add --transport http artemis ${MCP_URL} \\
  --header "Authorization: Bearer art_test_YOUR_TOKEN"`}</code></pre>
  <p><Fragment set:html={t('docs.mcpClaude.verify', { price: money(4900, { whole: true }) })} /></p>
  <h2>Claude Desktop</h2>
  <p><Fragment set:html={t('docs.mcpClaude.desktopBody')} /></p>
  <pre><code>{JSON.stringify({ mcpServers: { artemis: { type: 'http', url: MCP_URL, headers: { Authorization: 'Bearer art_test_YOUR_TOKEN' } } } }, null, 2)}</code></pre>
  <h2>{t('docs.mcpClaude.instructionsTitle')}</h2>
  <p>{t('docs.mcpClaude.instructionsBody')}</p>
  <pre><code>{`For any payment, use the Artemis tool request_card (amount in cents).
If the status is pending_approval, wait by calling get_request_status.
Once approved, call get_card_for_checkout only once, at the moment of payment, and open the returned link.
Never copy the card number into your reply.`}</code></pre>
</DocsLayout>
