---
import DocsLayout from '../../../components/DocsLayout.astro';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<DocsLayout title={t('docs.rules.title')} lead={t('docs.rules.lead')}>
  <h2>{t('docs.rules.orderTitle')}</h2>
  <p>{t('docs.rules.orderBody')}</p>
  <ol>
    {(['o1', 'o2', 'o3', 'o4', 'o5'] as const).map((k) => <li><Fragment set:html={t(`docs.rules.${k}`)} /></li>)}
  </ol>
  <h2>{t('docs.rules.autoTitle')}</h2>
  <p><Fragment set:html={t('docs.rules.autoBody')} /></p>
  <h2>{t('docs.rules.matchTitle')}</h2>
  <p>{t('docs.rules.matchBody')}</p>
  <h2>{t('docs.rules.humanTitle')}</h2>
  <p>{t('docs.rules.humanBody')}</p>
  <h2>{t('docs.rules.expiryTitle')}</h2>
  <p>{t('docs.rules.expiryBody')}</p>
</DocsLayout>
