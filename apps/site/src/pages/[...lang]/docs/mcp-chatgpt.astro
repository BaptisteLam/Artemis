---
import DocsLayout from '../../../components/DocsLayout.astro';
import { MCP_URL } from '../../../config';
import { i18n, localeStaticPaths } from '../../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<DocsLayout title={t('docs.mcpChatgpt.title')} lead={t('docs.mcpChatgpt.lead')}>
  <h2>{t('docs.mcpChatgpt.addTitle')}</h2>
  <ol>
    <li><Fragment set:html={t('docs.mcpChatgpt.step1')} /></li>
    <li><Fragment set:html={t('docs.mcpChatgpt.step2', { url: MCP_URL })} /></li>
    <li><Fragment set:html={t('docs.mcpChatgpt.step3')} /></li>
  </ol>
  <p>{t('docs.mcpChatgpt.note')}</p>
  <h2>{t('docs.mcpChatgpt.openaiTitle')}</h2>
  <p><Fragment set:html={t('docs.mcpChatgpt.openaiBody', { url: MCP_URL })} /></p>
</DocsLayout>
