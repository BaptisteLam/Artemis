---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Window from '../../components/Window.astro';
import Amount from '../../components/Amount.astro';
import { APP_URL } from '../../config';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, href, money, locale } = i18n(Astro.url);
const eur = (n: number) => money(n * 100, { whole: true });
---
<Base title={t('agencies.title')} description={t('agencies.description')}>
  <PageHead eyebrow={t('agencies.eyebrow')} title={t('agencies.headline')} lead={t('agencies.lead')}>
    <div class="ar-row" style="margin-top:24px">
      <a class="ar-btn ar-btn-primary" href={`${APP_URL}/signup?plan=agency&lang=${locale}`}>{t('agencies.try')}</a>
      <a class="ar-btn ar-btn-ghost" href={href('/pricing')}>{t('agencies.plan', { plan: t('plans.agency'), base: eur(249), client: eur(15) })}</a>
    </div>
  </PageHead>
  <div class="ar-container section hero-grid" style="align-items:start">
    <article class="prose">
      <h2>{t('agencies.spaces.title')}</h2>
      <p>{t('agencies.spaces.body')}</p>
      <h2>{t('agencies.budget.title')}</h2>
      <p>{t('agencies.budget.body')}</p>
      <h2>{t('agencies.rebilling.title')}</h2>
      <p>{t('agencies.rebilling.body')}</p>
      <h2>{t('agencies.proof.title')}</h2>
      <p>{t('agencies.proof.body')}</p>
      <h2>{t('agencies.european.title')}</h2>
      <p>{t('agencies.european.body')}</p>
    </article>
    <Window title={t('agencies.demo.window')}>
      <table class="ar-table">
        <tr><td>{'Notion'}</td><td class="ar-mono">{'menu.agent'}</td><td><Amount cents={4900} size="sm" /></td></tr>
        <tr><td>OpenAI API</td><td class="ar-mono">{'reviews.agent'}</td><td><Amount cents={2000} size="sm" /></td></tr>
        <tr><td>{'Canva'}</td><td class="ar-mono">{'menu.agent'}</td><td><Amount cents={1200} size="sm" /></td></tr>
        <tr><td><strong>{t('agencies.demo.subtotal')}</strong></td><td></td><td><Amount cents={8100} size="sm" /></td></tr>
        <tr><td>{t('agencies.demo.fee')}</td><td></td><td><Amount cents={1215} size="sm" /></td></tr>
        <tr><td><strong>{t('agencies.demo.total')}</strong></td><td></td><td><Amount cents={9315} size="sm" /></td></tr>
      </table>
    </Window>
  </div>
</Base>
