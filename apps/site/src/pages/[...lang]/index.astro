---
import StageFx from '../../components/StageFx.astro';
import WorksWith from '../../components/WorksWith.astro';
import StageMark from '../../components/StageMark.astro';
import PayCard from '../../components/PayCard.astro';
import Faq from '../../components/Faq.astro';
import Base from '../../layouts/Base.astro';
import Window from '../../components/Window.astro';
import Amount from '../../components/Amount.astro';
import { APP_URL } from '../../config';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, href, money, number, locale } = i18n(Astro.url);
const signup = `${APP_URL}/signup?lang=${locale}`;
const fee = money(4900);
const merchant = 'Notion';
const notionTag = `${fee} · ${merchant}`;
const notionAgent = 'notion.agent';
const notionRoute = `${notionAgent} ↳ studio-lumen`;

const trust = [
  [t('home.trust.europe'), t('home.trust.europeText')],
  [t('home.trust.funds'), t('home.trust.fundsText')],
  [t('home.trust.number'), t('home.trust.numberText')],
  [t('home.trust.aiAct'), t('home.trust.aiActText')],
];

const benefits = (['control', 'time', 'proof', 'agencies'] as const).map((k) => ({
  eyebrow: t(`home.benefits.${k}.eyebrow`),
  title: t(`home.benefits.${k}.title`),
  text: t(`home.benefits.${k}.text`),
}));

const bankCant = (['banks', 'accounting', 'proof', 'agency'] as const).map((k) => [t(`home.honest.${k}`), t(`home.honest.${k}Text`)]);

const useCases = [
  { title: t('home.useCases.api.title'), text: t('home.useCases.api.text'), merchants: ['OpenAI API', 'Anthropic API', 'Mistral'] },
  { title: t('home.useCases.saas.title'), text: t('home.useCases.saas.text'), merchants: ['Notion', 'Figma', 'Linear'] },
  { title: t('home.useCases.cloud.title'), text: t('home.useCases.cloud.text'), merchants: ['Vercel', 'Scaleway', 'OVHcloud'] },
  { title: t('home.useCases.data.title'), text: t('home.useCases.data.text'), merchants: ['Apify', 'Pappers', t('home.useCases.data.supplier')] },
];

type Cell = 'yes' | 'no' | 'yesBank' | 'yesQuorum' | 'dependsPlan' | 'dependsBank' | 'partial';
const compare: [string, Cell, Cell, Cell][] = [
  ['card', 'yes', 'yes', 'yesBank'],
  ['banks', 'no', 'no', 'yes'],
  ['signature', 'no', 'dependsPlan', 'yesQuorum'],
  ['aiAct', 'no', 'no', 'yes'],
  ['accounting', 'partial', 'no', 'yes'],
  ['agency', 'no', 'no', 'yes'],
  ['europe', 'dependsBank', 'no', 'yes'],
];
const tone = (v: Cell) => (v.startsWith('yes') ? 'gain' : v === 'no' ? 'loss' : 'pending');
const cell = (v: Cell) => t(`home.compare.values.${v}`);
---
<Base title="Artemis" stage>
  <section class="ar-stage home-hero">
    <StageFx />
    <div class="ar-container hero hero-grid">
      <div class="hero-copy">
        <span class="ar-micro eyebrow">{t('home.hero.eyebrow')}</span>
        <h1 class="ar-display">{t('meta.tagline')}</h1>
        <p class="ar-lead">{t('home.hero.lead')}</p>
        <div class="ar-row">
          <a class="ar-btn ar-btn-primary" href={signup}>{t('home.hero.tryFree')}</a>
          <a class="ar-btn ar-btn-ghost" href="#demo">{t('home.hero.seeDemo')}</a>
        </div>
        <WorksWith />
      </div>
      <div class="hero-visual" aria-label={t('home.hero.visualAria')}>
        <div class="card-stack">
          <PayCard class="card-back" variant="glass" last4="0517" holder="cloud.agent" exp="11/29" tag={t('home.hero.expired')} />
          <PayCard class="card-front" variant="cobalt" last4="4832" holder={notionAgent} exp="12/29" tag={notionTag} />
        </div>
        <div class="ar-glass-frost hero-approval ar-rise">
          <div class="ar-spread">
            <span class="ar-micro">{t('home.hero.pending')}</span>
            <span class="ar-badge ar-badge-pending ar-badge-live"><span class="ar-badge-dot"></span>{t('home.hero.toApprove')}</span>
          </div>
          <div class="req-row">
            <span class="ar-merchant">N</span>
            <div class="grow">
              <div><strong>{merchant}</strong> · {t('home.hero.purpose')}</div>
              <div class="ar-mono">{notionRoute}</div>
            </div>
            <Amount cents={4900} />
          </div>
          <div class="ar-row">
            <span class="ar-btn ar-btn-primary ar-btn-sm">{t('home.hero.approve')}</span>
            <span class="ar-btn ar-btn-ghost ar-btn-sm">{t('home.hero.decline')}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust" aria-label={t('home.trust.aria')}>
    <ul class="ar-container trust-list">
      {trust.map(([title, d]) => <li><strong>{title}</strong><span>{d}</span></li>)}
    </ul>
  </section>

  <section class="section" id="demo">
    <div class="ar-container ar-stack" style="gap:40px">
      <div class="section-head">
        <span class="ar-micro eyebrow">{t('home.demo.eyebrow')}</span>
        <h2 class="ar-h1 ar-headline">{t('home.demo.title')} <span class="ar-headline-explain">{t('home.demo.explain')}</span></h2>
      </div>
      <ol class="flow">
        <li class="flow-step">
          <span class="flow-num">01 · {t('home.demo.step1')}</span>
          <Window title={t('home.demo.window')}>
            <div class="chat">
              <p class="chat-user">{t('home.demo.userMessage')}</p>
              <div class="chat-tool">
                <span class="ar-mono">{'artemis.request_card'}</span>
                <code>{'{ amount: 4900, merchant: "Notion",\n  purpose: "team subscription" }'}</code>
              </div>
              <p class="chat-agent">{t('home.demo.agentMessage', { amount: fee })}</p>
            </div>
          </Window>
        </li>
        <li class="flow-step">
          <span class="flow-num">02 · {t('home.demo.step2')}</span>
          <div class="phone" aria-hidden="true">
            <div class="phone-screen">
              <div class="phone-notif">
                <span class="phone-app"><svg viewBox="0 0 714 496" width="14" height="10" fill="#fff"><path d="M0 496 L510 0 L510 280 L292 496 Z"/><path d="M510 280 H714 V496 H510 Z"/></svg></span>
                <div><strong>{t('home.demo.notification', { agent: notionAgent, amount: fee })}</strong><span>{merchant} · {t('home.hero.purpose')}</span></div>
              </div>
              <div class="phone-sheet">
                <span class="phone-face" aria-hidden="true"></span>
                <strong>{t('home.demo.sheetTitle')}</strong>
                <span class="ar-mono">{notionTag} · {t('home.demo.validity', { minutes: number(30) })}</span>
                <span class="ar-btn ar-btn-primary ar-btn-sm">{t('home.demo.faceId')}</span>
              </div>
            </div>
          </div>
        </li>
        <li class="flow-step">
          <span class="flow-num">03 · {t('home.demo.step3')}</span>
          <div class="flow-card">
            <PayCard variant="cobalt" last4="4832" holder={notionAgent} exp="12/29" tag={notionTag} state="used" />
            <div class="flow-receipt ar-solid">
              <span class="ar-badge ar-badge-gain"><span class="ar-badge-dot"></span>{t('home.demo.reconciled')}</span>
              <span>{merchant}</span>
              <Amount cents={-4900} size="sm" />
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-flush-top">
    <div class="ar-container ar-stack" style="gap:40px">
      <div class="section-head">
        <span class="ar-micro eyebrow">{t('home.benefits.eyebrow')}</span>
        <h2 class="ar-h1 ar-headline">{t('home.benefits.title')} <span class="ar-headline-explain">{t('home.benefits.explain')}</span></h2>
      </div>
      <div class="ar-bento">
        {benefits.map((b) => (
          <div class="ar-solid">
            <span class="ar-micro eyebrow">{b.eyebrow}</span>
            <h3 class="ar-h3">{b.title}</h3>
            <p class="ar-muted">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ar-stage ar-stage-quiet has-mark">
    <StageFx />
    <StageMark />
    <div class="ar-container section">
      <span class="ar-micro eyebrow">{t('home.how.eyebrow')}</span>
      <h2 class="ar-h1" style="margin-bottom:40px">{t('home.how.title')}</h2>
      <ol class="steps">
        <li class="ar-glass"><h3 class="ar-h3">{t('home.how.s1')}</h3><p class="ar-muted">{t('home.how.s1Text', { amount: fee })}</p></li>
        <li class="ar-glass"><h3 class="ar-h3">{t('home.how.s2')}</h3><p class="ar-muted">{t('home.how.s2Text')}</p></li>
        <li class="ar-glass"><h3 class="ar-h3">{t('home.how.s3')}</h3><p class="ar-muted">{t('home.how.s3Text')}</p></li>
        <li class="ar-glass"><h3 class="ar-h3">{t('home.how.s4')}</h3><p class="ar-muted">{t('home.how.s4Text')}</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="ar-container ar-stack" style="gap:40px">
      <div class="section-head">
        <span class="ar-micro eyebrow">{t('home.useCases.eyebrow')}</span>
        <h2 class="ar-h1 ar-headline">{t('home.useCases.title')} <span class="ar-headline-explain">{t('home.useCases.explain')}</span></h2>
      </div>
      <div class="usecases">
        {useCases.map((u) => (
          <article class="ar-solid usecase">
            <h3 class="ar-h3">{u.title}</h3>
            <p class="ar-muted">{u.text}</p>
            <ul class="usecase-merchants">
              {u.merchants.map((m) => <li><span class="ar-merchant">{m.split(/\s+/).slice(0, 2).map((w) => w[0]).join('')}</span>{m}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-flush-top">
    <div class="ar-container honest">
      <div>
        <span class="ar-micro eyebrow">{t('home.honest.eyebrow')}</span>
        <h2 class="ar-h1 ar-headline">{t('home.honest.title')} <span class="ar-headline-explain">{t('home.honest.explain')}</span></h2>
        <p class="ar-lead ar-muted" style="margin-top:16px">{t('home.honest.lead')}</p>
      </div>
      <ol class="honest-list">
        {bankCant.map(([title, d]) => <li class="ar-solid"><strong>{title}</strong><span class="ar-muted">{d}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="ar-stage ar-stage-quiet europe">
    <StageFx />
    <div class="ar-container section europe-inner">
      <div>
        <span class="ar-micro eyebrow">{t('home.europe.eyebrow')}</span>
        <h2 class="ar-h1">{t('home.europe.title')}</h2>
        <p class="ar-lead">{t('home.europe.lead')}</p>
      </div>
      <ul class="europe-list">
        <li class="ar-glass"><strong>€</strong><span>{t('home.europe.banks')}</span></li>
        <li class="ar-glass"><strong>{t('home.europe.eu')}</strong><span>{t('home.europe.data')}</span></li>
        <li class="ar-glass"><strong>{t('home.europe.article')}</strong><span>{t('home.europe.oversight')}</span></li>
        <li class="ar-glass"><strong>FEC</strong><span>{t('home.europe.accounting')}</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="ar-container ar-stack" style="gap:32px">
      <div class="section-head">
        <span class="ar-micro eyebrow">{t('home.compare.eyebrow')}</span>
        <h2 class="ar-h1 ar-headline">{t('home.compare.title')} <span class="ar-headline-explain">{t('home.compare.explain')}</span></h2>
      </div>
      <div class="ar-solid compare-wrap">
        <table class="ar-table compare">
          <thead>
            <tr><th scope="col"><span class="ar-sr">{t('home.compare.criterion')}</span></th><th scope="col">{t('home.compare.bankOnly')}</th><th scope="col">{t('home.compare.usCards')}</th><th scope="col" class="compare-us">Artemis</th></tr>
          </thead>
          <tbody>
            {compare.map(([label, a, b, c]) => (
              <tr>
                <th scope="row">{t(`home.compare.rows.${label}`)}</th>
                <td data-label={t('home.compare.bankOnlyShort')}><span class={`ar-badge ar-badge-${tone(a)}`}><span class="ar-badge-dot"></span>{cell(a)}</span></td>
                <td data-label={t('home.compare.usCardsShort')}><span class={`ar-badge ar-badge-${tone(b)}`}><span class="ar-badge-dot"></span>{cell(b)}</span></td>
                <td data-label="Artemis" class="compare-us"><span class={`ar-badge ar-badge-${tone(c)}`}><span class="ar-badge-dot"></span>{cell(c)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-flush-top">
    <div class="ar-container hero-grid builders">
      <div>
        <span class="ar-micro eyebrow">{t('home.builders.eyebrow')}</span>
        <h2 class="ar-h1 ar-headline">{t('home.builders.title')} <span class="ar-headline-explain">{t('home.builders.explain')}</span></h2>
        <p class="ar-lead ar-muted" style="margin-top:16px">{t('home.builders.lead')}</p>
        <div class="ar-row">
          <a class="ar-btn ar-btn-primary" href={href('/docs/mcp-claude')}>{t('home.builders.connect')}</a>
          <a class="ar-btn ar-btn-ghost" href={href('/docs/api')}>{t('footer.restApi')}</a>
        </div>
      </div>
      <Window title={t('home.builders.window')} tilt="r">
        <pre class="ar-mono term">claude mcp add --transport http artemis \
  https://api.artemis.dev/mcp \
  --header "Authorization: Bearer art_test_…"

› request_card(4900, "EUR", "Notion", "team subscription")
↳ pending_approval · req_8f2c</pre>
      </Window>
    </div>
  </section>

  <section class="section section-flush-top">
    <div class="ar-container faq-grid">
      <div>
        <span class="ar-micro eyebrow">{t('home.faq.eyebrow')}</span>
        <h2 class="ar-h1">{t('home.faq.title')}</h2>
        <p class="ar-muted" style="margin-top:12px"><Fragment set:html={t('home.faq.more', { security: href('/security'), docs: href('/docs') })} /></p>
      </div>
      <Faq />
    </div>
  </section>

  <section class="ar-stage final-cta">
    <StageFx />
    <div class="ar-container final-cta-inner">
      <div>
        <h2 class="ar-hero">{t('home.final.title')}</h2>
        <p class="ar-lead">{t('home.final.lead')}</p>
        <div class="ar-row">
          <a class="ar-btn ar-btn-primary" href={signup}>{t('home.final.signup')}</a>
          <a class="ar-btn ar-btn-ghost" href={href('/pricing')}>{t('home.final.pricing')}</a>
        </div>
      </div>
      <PayCard class="final-card" variant="glass" last4="2026" holder={t('home.final.holder')} exp="12/29" tag="Sandbox" />
    </div>
  </section>
</Base>
