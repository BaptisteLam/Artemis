---
import LegalLayout from '../../components/LegalLayout.astro';
import { LEGAL } from '../../legal';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t } = i18n(Astro.url);
---
<LegalLayout title={t('legalPages.notice.title')}>
  <h2>{t('legalPages.notice.editorTitle')}</h2>
  <p>{t('legalPages.notice.editor', { editor: LEGAL.editor, status: t('legal.status') })}<br />{t('legalPages.notice.siret', { siret: LEGAL.siret })}<br />{t('legalPages.notice.address', { address: LEGAL.address })}<br />{t('legalPages.notice.contact', { email: LEGAL.email })}<br />{t('legal.vat')}</p>
  <h2>{t('legalPages.notice.directorTitle')}</h2>
  <p>{LEGAL.editor}</p>
  <h2>{t('legalPages.notice.hostingTitle')}</h2>
  <p>{t('legal.host')}</p>
  <h2>{t('legalPages.notice.natureTitle')}</h2>
  <p>{t('legalPages.notice.nature')}</p>
  <h2>{t('legalPages.notice.ipTitle')}</h2>
  <p>{t('legalPages.notice.ip')}</p>
</LegalLayout>
