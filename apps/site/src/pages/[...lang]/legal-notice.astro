---
import LegalLayout from '../../components/LegalLayout.astro';
import { LEGAL } from '../../legal';
import { localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
---
<LegalLayout title="Mentions légales">
  <h2>Éditeur</h2>
  <p>{LEGAL.editor}, {LEGAL.status}<br />SIRET : {LEGAL.siret}<br />Adresse : {LEGAL.address}<br />Contact : {LEGAL.email}<br />{LEGAL.vat}</p>
  <h2>Directeur de la publication</h2>
  <p>{LEGAL.editor}</p>
  <h2>Hébergement</h2>
  <p>{LEGAL.host}</p>
  <h2>Nature du service</h2>
  <p>Artemis est un logiciel de gouvernance des dépenses d'agents d'intelligence artificielle. Artemis n'est ni un établissement de paiement ni un établissement de monnaie électronique : il ne reçoit, ne détient et ne transfère aucun fonds. Les cartes de paiement sont émises par l'établissement bancaire du client, sous sa responsabilité.</p>
  <h2>Propriété intellectuelle</h2>
  <p>Les contenus, marques et logos de ce site sont la propriété de l'éditeur. Toute reproduction sans autorisation est interdite.</p>
</LegalLayout>
