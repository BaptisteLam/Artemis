---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Window from '../../components/Window.astro';
import Amount from '../../components/Amount.astro';
import { i18n, localeStaticPaths } from '../../i18n';
export function getStaticPaths() {
  return localeStaticPaths();
}
const { t, money, number } = i18n(Astro.url);
---
<Base title={t('howItWorks.title')} description={t('howItWorks.description')}>
  <PageHead eyebrow={t('howItWorks.title')} title={t('howItWorks.headline')} lead={t('howItWorks.lead')} />
  <div class="ar-container section hero-grid" style="align-items:start">
    <article class="prose">
      <h2>{t('howItWorks.step1.title')}</h2>
      <p><Fragment set:html={t('howItWorks.step1.body')} /></p>
      <h2>{t('howItWorks.step2.title')}</h2>
      <p>{t('howItWorks.step2.body')}</p>
      <h2>{t('howItWorks.step3.title')}</h2>
      <p><Fragment set:html={t('howItWorks.step3.body')} /></p>
      <h2>{t('howItWorks.step4.title')}</h2>
      <p>{t('howItWorks.step4.body')}</p>
      <h2>{t('howItWorks.step5.title')}</h2>
      <p>{t('howItWorks.step5.body')}</p>
    </article>
    <div class="ar-stack" style="gap:40px">
      <Window title={t('howItWorks.demo.mandate', { id: 'req_8f2c' })} tilt="l">
        <div class="ar-stack" style="gap:8px">
          <div class="req-row"><span class="ar-merchant">N</span><div class="grow"><strong>{'Notion'}</strong><div class="ar-mono">{'notion.agent'}</div></div><Amount cents={4900} /></div>
          <p class="ar-small ar-muted" style="margin:0">{t('howItWorks.demo.intent')}</p>
          <p class="ar-small" style="margin:0">{t('howItWorks.demo.rules', { cap: money(10000), remaining: money(35100) })}</p>
          <span class="ar-badge ar-badge-gain"><span class="ar-badge-dot"></span>{t('howItWorks.demo.signed', { minutes: number(2) })}</span>
        </div>
      </Window>
      <Window title={t('howItWorks.demo.transactions')}>
        <table class="ar-table">
          <tr><td>{'Notion'}</td><td><Amount cents={-4900} size="sm" /></td><td><span class="ar-badge ar-badge-gain"><span class="ar-badge-dot"></span>{t('howItWorks.demo.matched')}</span></td></tr>
          <tr><td>OpenAI API</td><td><Amount cents={-2000} size="sm" /></td><td><span class="ar-badge ar-badge-gain"><span class="ar-badge-dot"></span>{t('howItWorks.demo.matched')}</span></td></tr>
          <tr><td>{'Figma'}</td><td><Amount cents={-1500} size="sm" /></td><td><span class="ar-badge ar-badge-loss"><span class="ar-badge-dot"></span>{t('howItWorks.demo.mismatch')}</span></td></tr>
        </table>
      </Window>
    </div>
  </div>
</Base>
