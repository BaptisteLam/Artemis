---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { PLAN_LIMITS } from '@artemis/shared';
import { APP_URL } from '../config';
const fmt = (n: number, unit: string) => (n === Infinity ? `${unit} illimités` : `${n} ${unit}`);
const plans = [
  { id: 'sandbox', name: 'Sandbox', pitch: 'Tester avec une banque simulée.', items: ['1 agent', 'Banque simulée', `${PLAN_LIMITS.sandbox.requestsPerMonth} mandats simulés / mois`, 'MCP, API, CLI'] },
  { id: 'builder', name: 'Builder', pitch: 'Pour un freelance ou un dev et ses agents.', items: ['3 agents', '1 banque connectée', `${PLAN_LIMITS.builder.requestsPerMonth} mandats / mois`, 'Validation par passkey', 'Garde-fous anti-injection'] },
  { id: 'team', name: 'Team', pitch: 'Pour une startup de 5 à 50 personnes.', items: ['10 agents', '2 banques', `${PLAN_LIMITS.team.requestsPerMonth} mandats / mois`, 'Slack et quorum d’approbateurs', 'Abonnements, export FEC'] },
  { id: 'agency', name: 'Agences', pitch: 'Pour les agences d’automatisation.', featured: true, items: ['Clients illimités, 25 agents', `${PLAN_LIMITS.agency.requestsPerMonth.toLocaleString('fr-FR')} mandats / mois`, 'Budgets et marge par client', 'Rapport mensuel à refacturer', '+ 15 € par client actif'] },
  { id: 'business', name: 'Business', pitch: 'Pour les scale-ups régulées.', items: ['Illimité', 'Dossier et rapport AI Act', 'Export signé du journal', 'Accompagnement prioritaire'] },
] as const;
---
<Base title="Tarifs" description="Sandbox gratuite, puis 29, 99, 249 ou 690 € par mois. Aucune commission sur vos dépenses.">
  <PageHead eyebrow="Tarifs" title="Un abonnement simple. Aucune commission." lead="Vous ne payez que le logiciel. Les cartes sont émises par votre banque, selon votre forfait bancaire habituel." />
  <div class="ar-container section">
    <div class="price-grid">
      {plans.map((p) => (
        <div class:list={['ar-solid', 'price', 'featured' in p && 'price-featured']}>
          <div class="ar-spread"><h2 class="ar-h3">{p.name}</h2>{'featured' in p && <span class="ar-badge ar-badge-info"><span class="ar-badge-dot"></span>Le plus choisi</span>}</div>
          <div><span class="ar-amount ar-amount-xl">{p.id === 'business' ? 'dès ' : ''}{PLAN_LIMITS[p.id].priceEur} €</span> <span class="ar-muted ar-small">/ mois</span></div>
          <p class="ar-muted ar-small" style="margin:0">{p.pitch}</p>
          <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
          <a class:list={['ar-btn', 'featured' in p ? 'ar-btn-primary' : 'ar-btn-ghost']} style="margin-top:auto" href={`${APP_URL}/inscription?plan=${p.id}`}>{p.id === 'sandbox' ? 'Commencer' : `Choisir ${p.name}`}</a>
        </div>
      ))}
    </div>
    <article class="prose" style="margin-top:64px">
      <h2>Questions fréquentes</h2>
      <h3>Y a-t-il des frais par carte ?</h3>
      <p>Pas chez Artemis. Votre banque applique son propre forfait (les cartes virtuelles sont incluses dans la plupart des offres Qonto et Revolut Business ; Stripe Issuing facture selon sa grille).</p>
      <h3>Que se passe-t-il si je dépasse mon quota ?</h3>
      <p>Sur un plan payant, vos agents continuent : chaque mandat au-delà du quota est facturé 0,25 € à la fin du mois. En Sandbox, les demandes sont refusées avec le code <code>quota_exceeded</code>.</p>
      <h3>Comment est facturé le plan Agences ?</h3>
      <p>249 € par mois, plus 15 € par client actif, c'est-à-dire chaque client pour lequel au moins un mandat a été créé dans le mois.</p>
      <h3>Puis-je résilier à tout moment ?</h3>
      <p>Oui, depuis l'espace Facturation. L'abonnement court jusqu'à la fin de la période payée ; vos données restent exportables.</p>
      <h3>TVA</h3>
      <p>TVA non applicable, art. 293 B du CGI. Les prix affichés sont nets.</p>
    </article>
  </div>
</Base>
