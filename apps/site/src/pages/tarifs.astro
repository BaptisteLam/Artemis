---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { PLAN_LIMITS } from '@artemis/shared';
import { APP_URL } from '../config';
const fmt = (n: number, unit: string) => (n === Infinity ? `${unit} illimités` : `${n} ${unit}`);
const plans = [
  { id: 'sandbox', name: 'Sandbox', pitch: 'Tester sans banque, avec des cartes simulées.', items: [fmt(PLAN_LIMITS.sandbox.agents, 'agent'), 'Banque simulée uniquement', `${PLAN_LIMITS.sandbox.requestsPerMonth} demandes / mois`, 'MCP et API REST'] },
  { id: 'builder', name: 'Builder', pitch: 'Pour un freelance ou un dev et ses agents.', items: [fmt(PLAN_LIMITS.builder.agents, 'agents'), '1 banque connectée', `${PLAN_LIMITS.builder.requestsPerMonth} demandes / mois`, 'Validation par passkey', 'Export CSV'] },
  { id: 'team', name: 'Team', pitch: 'Pour un studio ou une PME.', featured: true, items: [fmt(PLAN_LIMITS.team.agents, 'agents'), '2 banques connectées', `${PLAN_LIMITS.team.requestsPerMonth.toLocaleString('fr-FR')} demandes / mois`, 'Plusieurs approbateurs', 'Export FEC (Pennylane)'] },
  { id: 'business', name: 'Business', pitch: 'Pour les équipes qui industrialisent.', items: ['Agents illimités', 'Banques illimitées', 'Demandes illimitées (usage raisonnable)', 'Export du journal AI Act', 'Support prioritaire'] },
] as const;
---
<Base title="Tarifs" description="Sandbox gratuite, puis 19, 49 ou 149 € par mois. Aucune commission sur vos dépenses.">
  <PageHead eyebrow="Tarifs" title="Un abonnement simple. Aucune commission." lead="Vous ne payez que le logiciel. Les cartes sont émises par votre banque, selon votre forfait bancaire habituel." />
  <div class="ar-container section">
    <div class="price-grid">
      {plans.map((p) => (
        <div class:list={['ar-solid', 'price', 'featured' in p && 'price-featured']}>
          <div class="ar-spread"><h2 class="ar-h3">{p.name}</h2>{'featured' in p && <span class="ar-badge ar-badge-info"><span class="ar-badge-dot"></span>Le plus choisi</span>}</div>
          <div><span class="ar-amount ar-amount-xl">{PLAN_LIMITS[p.id].priceEur} €</span> <span class="ar-muted ar-small">/ mois</span></div>
          <p class="ar-muted ar-small" style="margin:0">{p.pitch}</p>
          <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
          <a class:list={['ar-btn', 'featured' in p ? 'ar-btn-primary' : 'ar-btn-ghost']} style="margin-top:auto" href={`${APP_URL}/inscription?plan=${p.id}`}>{p.id === 'sandbox' ? 'Commencer' : `Choisir ${p.name}`}</a>
        </div>
      ))}
    </div>
    <article class="prose" style="margin-top:64px">
      <h2>Questions fréquentes</h2>
      <h3>Y a-t-il des frais par carte ?</h3>
      <p>Pas chez Artemis. Votre banque applique son propre forfait (les cartes virtuelles sont incluses dans la plupart des offres Qonto et Revolut Business ; Stripe Issuing facture selon sa grille).</p>
      <h3>Que se passe-t-il si je dépasse mon quota ?</h3>
      <p>Les nouvelles demandes sont refusées avec le code <code>quota_exceeded</code> jusqu'au mois suivant ou jusqu'au passage à un plan supérieur. Rien n'est facturé en plus sans votre accord.</p>
      <h3>Puis-je résilier à tout moment ?</h3>
      <p>Oui, depuis l'espace Facturation. L'abonnement court jusqu'à la fin de la période payée ; vos données restent exportables.</p>
      <h3>TVA</h3>
      <p>TVA non applicable, art. 293 B du CGI. Les prix affichés sont nets.</p>
    </article>
  </div>
</Base>
