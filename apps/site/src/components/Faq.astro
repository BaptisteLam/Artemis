---
import { OVERAGE_CENTS, PLAN_LIMITS } from '@artemis/shared';
import { i18n } from '../i18n';
const { t, money } = i18n(Astro.url);
const eur = (n: number) => money(n * 100, { whole: true });
const price = {
  builder: eur(PLAN_LIMITS.builder.priceEur),
  team: eur(PLAN_LIMITS.team.priceEur),
  agency: eur(PLAN_LIMITS.agency.priceEur),
  client: eur(PLAN_LIMITS.agency.perClientEur),
  business: eur(PLAN_LIMITS.business.priceEur),
  overage: money(OVERAGE_CENTS),
  agencyPlan: t('plans.agency'),
  vat: t('legal.vat'),
};
const items = [1, 2, 3, 4, 5, 6, 7].map((n) => [t(`components.faq.q${n}`), t(`components.faq.a${n}`, price)]);
---
<div class="faq">
  {items.map(([q, a]) => (
    <details class="faq-item">
      <summary>{q}</summary>
      <p>{a}</p>
    </details>
  ))}
</div>
