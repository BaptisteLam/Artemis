---
/* Carte bancaire virtuelle réaliste (même rendu que le composant React PayCard de @artemis/ui). */
import { i18n } from '../i18n';
interface Props {
  last4: string;
  holder: string;
  exp: string;
  tag?: string;
  variant?: 'cobalt' | 'glass' | 'ink';
  state?: 'active' | 'used';
  class?: string;
  style?: string;
}
const { t } = i18n(Astro.url);
const { last4, holder, exp, tag = t('components.payCard.singleUse'), variant = 'cobalt', state = 'active', class: cls = '', style } = Astro.props;
---
<div class:list={['ar-paycard', `ar-paycard--${variant}`, cls]} data-state={state} role="img" aria-label={t('components.payCard.aria', { last4, holder, exp })} style={style}>
  <div class="ar-paycard-inner" aria-hidden="true">
    <div class="ar-paycard-top">
      <span class="ar-paycard-brand"><svg viewBox="0 0 714 496"><path d="M0 496 L510 0 L510 280 L292 496 Z" /><path d="M510 280 H714 V496 H510 Z" /></svg>Artemis</span>
      <span class="ar-paycard-tag">{tag}</span>
    </div>
    <div class="ar-paycard-mid">
      <span class="ar-paycard-chip"></span>
      <svg class="ar-paycard-nfc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8.5 8.5a5 5 0 0 1 0 7M12 6a8.5 8.5 0 0 1 0 12M15.5 3.5a12 12 0 0 1 0 17" /></svg>
    </div>
    <div class="ar-paycard-num">{`•••• •••• •••• ${last4}`}</div>
    <div class="ar-paycard-bottom">
      <div class="ar-paycard-field ar-paycard-field--grow"><small>{t('components.payCard.holder')}</small><span>{holder}</span></div>
      <div class="ar-paycard-field"><small>{t('components.payCard.expires')}</small><span>{exp}</span></div>
      <div class="ar-paycard-net">{t('components.payCard.debit')}<em>{t('components.payCard.virtual')}</em></div>
    </div>
  </div>
  {state === 'used' && <span class="ar-paycard-stamp">{t('components.payCard.used')}</span>}
</div>
