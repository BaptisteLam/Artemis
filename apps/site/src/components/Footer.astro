---
import { i18n } from '../i18n';
const { t, href } = i18n(Astro.url);
---
<footer class="site-footer">
  <div class="ar-container cols">
    <div>
      <p style="display:flex;align-items:center;gap:10px;color:var(--ar-ink);font:600 18px/1 var(--ar-font-display);letter-spacing:-0.05em;margin:0 0 12px">
        <svg viewBox="0 0 714 496" height="16" width="23" fill="var(--ar-cobalt)" aria-hidden="true"><path d="M0 496 L510 0 L510 280 L292 496 Z"/><path d="M510 280 H714 V496 H510 Z"/></svg>
        Artemis
      </p>
      <p>{t('meta.tagline')}</p>
      <p>{t('legal.vat')}</p>
      <p class="ar-small">{t('footer.trademarks')}</p>
    </div>
    <div>
      <p class="ar-micro">{t('footer.product')}</p>
      <ul><li><a href={href('/how-it-works')}>{t('nav.howItWorks')}</a></li><li><a href={href('/pricing')}>{t('nav.pricing')}</a></li><li><a href={href('/agencies')}>{t('nav.agencies')}</a></li><li><a href={href('/resources/agent-policy')}>{t('footer.policyTemplate')}</a></li><li><a href={href('/security')}>{t('nav.security')}</a></li><li><a href={href('/waitlist')}>{t('footer.waitlist')}</a></li></ul>
    </div>
    <div>
      <p class="ar-micro">{t('nav.docs')}</p>
      <ul><li><a href={href('/docs/mcp-claude')}>Claude</a></li><li><a href={href('/docs/mcp-chatgpt')}>ChatGPT</a></li><li><a href={href('/docs/n8n')}>n8n</a></li><li><a href={href('/docs/api')}>{t('footer.restApi')}</a></li></ul>
    </div>
    <div>
      <p class="ar-micro">{t('footer.legal')}</p>
      <ul><li><a href={href('/legal-notice')}>{t('footer.legalNotice')}</a></li><li><a href={href('/terms')}>{t('footer.terms')}</a></li><li><a href={href('/privacy')}>{t('footer.privacy')}</a></li></ul>
    </div>
  </div>
</footer>
