---
import { formatAmount } from '@artemis/shared';
interface Props { cents: number; size?: 'xl' | 'md' | 'sm'; sign?: boolean }
const { cents, size = 'md', sign = false } = Astro.props;
---
<span class:list={['ar-amount', `ar-amount-${size}`, sign && cents > 0 && 'ar-amount-gain', sign && cents < 0 && 'ar-amount-loss']}>{sign && cents !== 0 ? (cents > 0 ? '↑ ' : '↓ ') : ''}{formatAmount(cents, 'EUR', { sign })}</span>
