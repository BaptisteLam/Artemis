---
/* Logo Artemis stylisé en filigrane, très discret, au fond d'un stage. */
---
<svg class="stage-mark" viewBox="-20 -20 754 536" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="stage-mark-fill" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.10" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.01" />
    </linearGradient>
  </defs>
  <g fill="url(#stage-mark-fill)" stroke="#ffffff" stroke-opacity="0.16" stroke-width="2" vector-effect="non-scaling-stroke">
    <path d="M0 496 L510 0 L510 280 L292 496 Z" />
    <path d="M510 280 H714 V496 H510 Z" />
  </g>
  <g fill="none" stroke="#ffffff" stroke-opacity="0.07" stroke-width="1" vector-effect="non-scaling-stroke">
    <path d="M-20 496 H734 M510 -20 V516 M292 516 L828 -20" />
  </g>
</svg>
