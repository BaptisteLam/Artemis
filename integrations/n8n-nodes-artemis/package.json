{
  "name": "n8n-nodes-artemis",
  "version": "0.1.0",
  "description": "Nœud n8n Artemis : demander une carte virtuelle à usage unique validée par un humain, suivre la demande, obtenir le lien de paiement.",
  "keywords": ["n8n-community-node-package", "artemis", "payments", "ai agents"],
  "license": "MIT",
  "main": "index.js",
  "scripts": { "build": "tsc", "prepublishOnly": "npm run build" },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/ArtemisApi.credentials.js"],
    "nodes": ["dist/nodes/Artemis/Artemis.node.js"]
  },
  "devDependencies": { "n8n-workflow": "^1.70.0", "typescript": "^5.6.3" },
  "peerDependencies": { "n8n-workflow": "*" }
}
