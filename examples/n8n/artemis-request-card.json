{
  "name": "Artemis — demander une carte et attendre la validation",
  "nodes": [
    {
      "parameters": {},
      "id": "a1",
      "name": "Déclencheur manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.artemis.workers.dev/v1/card-requests",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"amount\": 4900,\n  \"currency\": \"EUR\",\n  \"merchant\": \"Notion\",\n  \"purpose\": \"abonnement équipe\"\n}",
        "options": {}
      },
      "id": "a2",
      "name": "Demander une carte",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "notes": "Créez une credential « Header Auth » : nom Authorization, valeur Bearer art_…"
    },
    {
      "parameters": { "amount": 20, "unit": "seconds" },
      "id": "a3",
      "name": "Attendre 20 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "=https://api.artemis.workers.dev/v1/card-requests/{{ $('Demander une carte').item.json.request_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a4",
      "name": "Statut",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.status }}", "rightValue": "issued", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a5",
      "name": "Carte émise ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.artemis.workers.dev/v1/card-requests/{{ $('Demander une carte').item.json.request_id }}/reveal",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a6",
      "name": "Récupérer la carte (une fois)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -100],
      "notes": "Utilisez la carte immédiatement dans le nœud suivant. Ne la stockez pas."
    }
  ],
  "connections": {
    "Déclencheur manuel": { "main": [[{ "node": "Demander une carte", "type": "main", "index": 0 }]] },
    "Demander une carte": { "main": [[{ "node": "Attendre 20 s", "type": "main", "index": 0 }]] },
    "Attendre 20 s": { "main": [[{ "node": "Statut", "type": "main", "index": 0 }]] },
    "Statut": { "main": [[{ "node": "Carte émise ?", "type": "main", "index": 0 }]] },
    "Carte émise ?": {
      "main": [
        [{ "node": "Récupérer la carte (une fois)", "type": "main", "index": 0 }],
        [{ "node": "Attendre 20 s", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
