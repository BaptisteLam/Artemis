# ── API (apps/api) : secrets Cloudflare, à définir avec `wrangler secret put NOM` ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # Supabase → Project Settings → API → service_role (secret)
CONNECTIONS_KEY=                     # openssl rand -base64 32 (chiffre les identifiants bancaires)
RESEND_API_KEY=                      # optionnel : emails (resend.com, gratuit 3 000/mois)
VAPID_PUBLIC_KEY=                    # optionnel : notifications push (npx web-push generate-vapid-keys)
VAPID_PRIVATE_KEY=
STRIPE_SECRET_KEY=                   # facturation des abonnements Artemis
STRIPE_WEBHOOK_SECRET=               # whsec_… du webhook /webhooks/stripe-billing
STRIPE_PRICE_BUILDER=                # price_… 19 €/mois
STRIPE_PRICE_TEAM=                   # price_… 49 €/mois
STRIPE_PRICE_BUSINESS=               # price_… 149 €/mois
# Variables non secrètes : voir apps/api/wrangler.toml ([vars])

# ── App (apps/app) : variables de build Cloudflare Pages ──
VITE_API_URL=https://artemis-api.<votre-sous-domaine>.workers.dev
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=              # clé publique (anon / publishable)
VITE_SITE_URL=https://artemis.pages.dev

# ── Site (apps/site) ──
PUBLIC_API_URL=https://artemis-api.<votre-sous-domaine>.workers.dev
PUBLIC_APP_URL=https://artemis-app.pages.dev
PUBLIC_SITE_URL=https://artemis.pages.dev
